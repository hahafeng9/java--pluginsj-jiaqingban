# 节点(代理)UUID —— 必填,用于 sing-box 各协议和分享链接
UUID=dbb4b08c-011a-44df-9012-d61bd72ea28c

# 探针 UUID —— 和节点分开;填了则哪吒探针用这个,留空则复用上面的 UUID
PROBE_UUID=

# 哪吒探针
NEZHA_SERVER=
NEZHA_PORT=
NEZHA_KEY=

# Argo / CF 隧道
ARGO_DOMAIN=
ARGO_AUTH=
DISABLE_ARGO=false

# 代理端口(不用的留空)
S5_PORT=
HY2_PORT=
TUIC_PORT=
ANYTLS_PORT=
REALITY_PORT=

# 节点信息/推送
CFIP=spring.io
CFPORT=443
NAME=my-node
CHAT_ID=
BOT_TOKEN=
UPLOAD_URL=

# 日志:false=静默(默认),true=输出
SHOW_LOG=false
